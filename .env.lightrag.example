# Project-side administration (host port)
LIGHTRAG_ADMIN_DSN=postgresql://traffic_rag_admin:change_me@127.0.0.1:55432/postgres
LIGHTRAG_DSN=postgresql://traffic_rag_lightrag_app:change_me@127.0.0.1:55432/traffic_rag_lightrag
LIGHTRAG_POSTGRES_DATABASE=traffic_rag_lightrag
LIGHTRAG_POSTGRES_USER=traffic_rag_lightrag_app
LIGHTRAG_POSTGRES_PASSWORD=change_me

# LightRAG release isolation
WORKSPACE=kg_v001_building
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# Local embedding; this is independent from frozen B7 embeddings
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192

# Hosted extraction/query LLM
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_BINDING_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ENTITY_EXTRACTION_USE_JSON=true
MAX_ASYNC_LLM=2

# Local-only server protection
LIGHTRAG_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=change_me_to_a_long_random_value

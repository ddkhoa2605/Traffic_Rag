POSTGRES_DB=traffic_rag
POSTGRES_ADMIN_USER=traffic_rag_admin
POSTGRES_ADMIN_PASSWORD=change-this-admin-password
POSTGRES_OWNER_PASSWORD=change-this-owner-password
POSTGRES_INGEST_PASSWORD=change-this-ingest-password
POSTGRES_RUNTIME_PASSWORD=change-this-runtime-password

# Local shadow instance. Port 55432 avoids the native PostgreSQL service on 5432.
TRAFFIC_RAG_ADMIN_DSN=postgresql://traffic_rag_admin:change-this-admin-password@127.0.0.1:55432/traffic_rag
TRAFFIC_RAG_OWNER_DSN=postgresql://traffic_rag_owner:change-this-owner-password@127.0.0.1:55432/traffic_rag
TRAFFIC_RAG_INGEST_DSN=postgresql://traffic_rag_ingest:change-this-ingest-password@127.0.0.1:55432/traffic_rag
TRAFFIC_RAG_RUNTIME_DSN=postgresql://traffic_rag_runtime:change-this-runtime-password@127.0.0.1:55432/traffic_rag
